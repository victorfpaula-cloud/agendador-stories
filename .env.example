# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Meta / Facebook App (developers.facebook.com)
FACEBOOK_APP_ID=seu-app-id
FACEBOOK_APP_SECRET=seu-app-secret
# Precisa ser EXATAMENTE a URL configurada no app do Meta (Valid OAuth Redirect URIs)
FACEBOOK_REDIRECT_URI=https://seu-dominio.vercel.app/api/auth/facebook/callback
GRAPH_API_VERSION=v20.0

# URL pública do site (usada em redirects)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Segredo que só o cron conhece, pra ninguém mais poder chamar a rota de publicação
CRON_SECRET=gere-uma-string-aleatoria-longa-aqui
